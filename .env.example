# Postgres bağlantısı (Neon). Boş bırakılırsa yerelde PGlite kullanılır.
DATABASE_URL=

# Sitenin adresi (mail içindeki linkler için). Boşsa istek başlığından alınır.
APP_URL=https://cekilis.example.com

# SMTP — Gmail için: smtp.gmail.com / 465 / Gmail adresin / 16 haneli uygulama şifresi
# Boş bırakılırsa yerelde mailler .dev-mails/ klasörüne yazılır.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Yılbaşı Çekilişi <senin-adresin@gmail.com>"
